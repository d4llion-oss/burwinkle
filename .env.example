# Copy to .env and fill in. Never commit .env.

# Your domain (used by Caddy for HTTPS). Leave as-is until DNS points here.
DOMAIN=burwinkle.example.com

# Signs the anonymous identity cookie. Generate with:
#   openssl rand -base64 48
SESSION_SECRET=change-me

# Moderation token. Enter it under Me > Moderation in the app to unlock
# deleting any story and viewing reports. Generate with:
#   openssl rand -base64 24
ADMIN_TOKEN=change-me-too

# Optional: use DigitalOcean Managed Postgres instead of the SQLite file.
# Leave unset on a Droplet (SQLite in the burwinkle-data volume is fine).
# DATABASE_URL=postgresql://user:pass@host:25060/burwinkle?sslmode=require
